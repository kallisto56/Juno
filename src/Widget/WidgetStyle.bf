namespace Juno;

using System;

// Default look of the built-in widgets. Change the fields to restyle everything.
static class WidgetStyle
{
	static public Color sPanelBackground = Color(30, 33, 42, 235);
	static public Color sPanelBorder = Color(90, 96, 120, 255);
	static public Color sText = Color(232, 234, 240, 255);
	static public Color sButton = Color(58, 64, 86, 255);
	static public Color sButtonHover = Color(78, 88, 120, 255);
	static public Color sButtonPressed = Color(40, 46, 66, 255);
	static public Color sButtonDisabled = Color(44, 46, 54, 255);
	static public Color sFocusRing = Color(96, 170, 255, 255);
}
