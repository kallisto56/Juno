namespace Juno;

using System;

// Default look of the built-in widgets. Change the fields to restyle everything.
static class WidgetStyle
{
	static public Color sPanelBackground = Colors.Make(30, 33, 42, 235);
	static public Color sPanelBorder = Colors.Make(90, 96, 120, 255);
	static public Color sText = Colors.Make(232, 234, 240, 255);
	static public Color sButton = Colors.Make(58, 64, 86, 255);
	static public Color sButtonHover = Colors.Make(78, 88, 120, 255);
	static public Color sButtonPressed = Colors.Make(40, 46, 66, 255);
	static public Color sButtonDisabled = Colors.Make(44, 46, 54, 255);
	static public Color sFocusRing = Colors.Make(96, 170, 255, 255);
}
