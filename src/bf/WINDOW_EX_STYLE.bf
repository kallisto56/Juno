namespace Juno;

using System;
using System.Interop;

enum WINDOW_EX_STYLE : uint32
{
	case WS_EX_LEFT = 0x00000000;
	case WS_EX_DLGMODALFRAME = 0x00000001;
	case WS_EX_NOPARENTNOTIFY = 0x00000004;
	case WS_EX_TOPMOST = 0x00000008;
	case WS_EX_ACCEPTFILES = 0x00000010;
	case WS_EX_TRANSPARENT = 0x00000020;
	case WS_EX_MDICHILD = 0x00000040;
	case WS_EX_TOOLWINDOW = 0x00000080;
	case WS_EX_WINDOWEDGE = 0x00000100;
	case WS_EX_CLIENTEDGE = 0x00000200;
	case WS_EX_CONTEXTHELP = 0x00000400;
	case WS_EX_RIGHT = 0x00001000;
	case WS_EX_RTLREADING = 0x00002000;
	case WS_EX_LEFTSCROLLBAR = 0x00004000;
	case WS_EX_CONTROLPARENT = 0x00010000;
	case WS_EX_STATICEDGE = 0x00020000;
	case WS_EX_APPWINDOW = 0x00040000;
	case WS_EX_LAYERED = 0x00080000;
	case WS_EX_NOINHERITLAYOUT = 0x00100000;
	case WS_EX_NOREDIRECTIONBITMAP = 0x00200000;
	case WS_EX_LAYOUTRTL = 0x00400000;
	case WS_EX_COMPOSITED = 0x02000000;
	case WS_EX_NOACTIVATE = 0x08000000;
	case WS_EX_OVERLAPPEDWINDOW = 0x00000300;
}
