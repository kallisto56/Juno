typealias LRESULT = int;
typealias HRESULT = int32;
typealias COLORREF = uint32;
typealias LPCWSTR = char16*;
typealias HWND = void*;
typealias HINSTANCE = void*;
typealias HMODULE = void*;
typealias HICON = void*;
typealias HCURSOR = void*;
typealias HBRUSH = void*;
typealias HMENU = void*;
typealias HMONITOR = void*;
